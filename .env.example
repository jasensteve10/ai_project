# Optional live application credentials. Local tests and saved-result review need none.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when GEMINI_MODEL is overloaded (503/504) or unavailable; all free tier.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# Optional separate Claude experiments; never enabled by local verification.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_WORKSPACE_ID=
LLM_FALLBACK=none
CLAUDE_FALLBACK_MAX_CALLS=20
