# Copy to .env (never commit .env). Only needed for live SQL generation and the app.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# App retrieval mode: A (no retrieval), B (BM25), C (E5), D (hybrid), F1/F3 (bounded agent)
RAG_CONDITION=B

# Optional Claude provider/fallback. Billed per token (no free tier). OFF unless LLM_FALLBACK=claude.
LLM_FALLBACK=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_WORKSPACE_ID=
CLAUDE_FALLBACK_MAX_CALLS=20
